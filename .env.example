# Скопируй этот файл в .env и заполни.
# Windows:     copy .env.example .env
# Linux/macOS: cp .env.example .env

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Кому можно пользоваться ботом: Telegram ID через запятую.
# Свой ID узнаешь командой /myid. Если оставить пустым, бот будет отвечать всем.
ALLOWED_USER_IDS=

# Биржи для сравнения (названия как в библиотеке ccxt)
EXCHANGES=bybit,bingx,okx,gate,mexc,kucoin,htx,bitget

# В какой валюте сравниваем цены
QUOTE=USDT

# Минимальная ЧИСТАЯ прибыль в % (после торговых комиссий), чтобы прислать сигнал
MIN_PROFIT_PERCENT=0.5

# Всё, что выше этого %, скорее всего ошибка: разные монеты с одинаковым тикером,
# закрытый вывод и т.п. Такие спреды отбрасываем.
MAX_PROFIT_PERCENT=15

# Минимальный суточный объём торгов в USD на КАЖДОЙ бирже (отсекаем неликвид)
MIN_VOLUME_USD=50000

# На какую сумму в USD проверяем стакан (хватит ли глубины)
TRADE_AMOUNT_USD=100

# Как часто сканировать в автоматическом режиме (секунды)
SCAN_INTERVAL_SEC=60

# Через сколько минут можно повторно прислать тот же сигнал
ALERT_COOLDOWN_MIN=30

# --- Демо-счёт (виртуальные деньги, реальные цены) ---

# Сколько минут монета "едет" с биржи на биржу. Продажа произойдёт по цене через это время.
DEMO_TRANSFER_MIN=10

# Комиссия за вывод монеты в $, если биржа не сообщает её без API-ключа.
# Реально обычно $0.1–1, у некоторых монет больше.
DEMO_WITHDRAW_FEE_USD=0.5

# Суммы демо-счетов для команды /demo_start без параметров
DEMO_AMOUNTS=5,50,500

# --- Треугольный арбитраж (внутри одной биржи) ---
# 1 = включён, 0 = выключен
TRIANGULAR=1
# Минимальная чистая прибыль цикла после трёх комиссий, %
TRI_MIN_PROFIT_PERCENT=0.15
# Всё, что выше, скорее всего устаревшая цена или неликвид, отбрасываем
TRI_MAX_PROFIT_PERCENT=5

# --- Ежедневный отчёт ---
# Час отправки по местному времени и смещение от UTC (Москва = 3)
REPORT_HOUR=9
REPORT_UTC_OFFSET=3

# --- Свои комиссии бирж (taker, в процентах) ---
# Если у тебя VIP или скидка за токен биржи. Остальные биржи берут стандартную ставку.
# То же можно сделать командой /fee bybit 0.08 прямо в Telegram.
FEE_OVERRIDES=

# --- ИИ-помощник (необязательно, бесплатно) ---
# Ключ Groq (gsk_...), OpenRouter (sk-or-...) или Google AI Studio (AIza...). Провайдер определяется сам.
# Бесплатный ключ без карты: https://console.groq.com/keys
AI_API_KEY=
# Запасные ключи: если основной упрётся в лимит, бот переключится на них
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Своя модель (по умолчанию выбирается автоматически лучшая доступная)
AI_MODEL=
# Свой OpenAI-совместимый адрес (например, локальная модель), обычно не нужен
AI_BASE_URL=
# Сколько запросов к ИИ бот делает максимум за сутки
AI_DAILY_LIMIT=300

# --- Торговля (необязательно) ---
# Ключи бирж: ТОЛЬКО спотовая торговля, вывод (Withdraw) НЕ включать!
# Формат: <БИРЖА>_API_KEY, <БИРЖА>_API_SECRET и для okx/kucoin/bitget ещё <БИРЖА>_API_PASSWORD
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINGX_API_KEY=
BINGX_API_SECRET=
# Если Bybit отвечает 403 «block access from your country», попробуй запасной домен:
# BYBIT_HOSTNAME=bytick.com

# Кошелёк Phantom (Solana), только просмотр: публичный адрес, НЕ сид-фраза
PHANTOM_ADDRESS=
# Свой узел Solana, если публичный отвечает «слишком много запросов» (например Helius)
# SOLANA_RPC_URL=

# Т-Инвестиции: токен T-Invest API с доступом «Только чтение» (бот только показывает портфель).
# Т-Банк → Инвестиции → Настройки → «Токены T-Invest API» → «Создать токен»
TINVEST_TOKEN=
# TINVEST_SANDBOX=1   # песочница Т-Банка вместо настоящих счетов
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
# Максимум на одну покупку или один треугольный цикл, $
MAX_TRADE_USD=10
# Если автоторговля за сутки потеряла столько $, она встаёт на паузу
DAILY_LOSS_USD=2
# Максимум реальных сделок бота за сутки
DAILY_TRADES=30
# Автоторговля берёт только циклы с прибылью по стакану не ниже, %
AUTO_MIN_PROFIT_PERCENT=0.3
# Если цена ушла хуже предпросмотра больше чем на столько %, рыночный ордер не отправляется
MAX_SLIPPAGE_PERCENT=1
# Сводка автоторговли в чат раз в N часов (0 = не присылать)
AUTO_REPORT_HOURS=6

# --- Приложение в Telegram (Mini App) ---
# На Render адрес подставляется сам. На другом хостинге укажи свой https-адрес:
# PUBLIC_URL=https://my-bot.example.com
# Порт сервера приложения при запуске на своём компьютере/сервере (на Render берётся PORT):
# WEBAPP_PORT=8080
